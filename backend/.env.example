# AI Provider Configuration ('gemini' | 'openai')
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Model Specifications
LLM_MODEL=gemini-1.5-flash
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768

# PostgreSQL with pgvector Database URLs
DATABASE_URL=postgresql+asyncpg://postgres:your_password@localhost:5432/db_ai_query
DATABASE_URL_SYNC=postgresql://postgres:your_password@localhost:5432/db_ai_query

# Server & CORS
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000"]

# Semantic Search & Vector Matching
SIMILARITY_THRESHOLD=0.82
TOP_K_MATCHES=3
